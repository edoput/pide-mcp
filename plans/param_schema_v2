data model delta (MCP_Tools.thy, MCP_TOOL signature ~143)
----------------------------------------------------------

  datatype ptyp =
    String | Source | Args | Nat | Int | Bool | Term | Typ | Fact
  | Enum of string list
  | List_Of of ptyp

  type param = {name: string, typ: ptyp, required: bool,
                default: string option, description: string}

  type annotations =
    {read_only: bool option, idempotent: bool option,
     destructive: bool option, open_world: bool option}

  datatype constraint = Exactly_One of string list

  type tool =
    {description: string, params: param list,
     constraints: constraint list, annotations: annotations,
     form: form, run: Proof.context -> (string * string) list -> string}

