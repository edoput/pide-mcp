#!/usr/bin/env python3
"""Execute the selected Isabelle command prefix without writing to stdout."""

from __future__ import annotations

import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from isabelle_launcher import LauncherError, resolve_launcher


def main() -> int:
    try:
        launcher = resolve_launcher()
    except LauncherError as ex:
        print(f"isabelle launcher: {ex}", file=sys.stderr)
        return 2
    try:
        if Path(launcher.argv[0]).exists() and Path(launcher.argv[0]).samefile(__file__):
            raise LauncherError("selected launcher is this wrapper itself; select the installation executable")
        os.execvp(launcher.argv[0], [*launcher.argv, *sys.argv[1:]])
    except (OSError, LauncherError) as ex:
        print(f"isabelle launcher: cannot execute {launcher.argv[0]!r}: {ex}", file=sys.stderr)
        return 127


if __name__ == "__main__":
    raise SystemExit(main())
