{
  "worktree": { "bgIsolation": "none" },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] && git ls-files --error-unmatch \"$f\" >/dev/null 2>&1 && git add \"$f\"; } 2>/dev/null || true",
            "statusMessage": "git add (tracked files only)"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/regenerate_assumptions.py\"",
            "statusMessage": "Regenerate plan assumption registry"
          }
        ]
      }
    ]
  }
}
