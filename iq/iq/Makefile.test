ISABELLE_BIN ?= $(if $(wildcard $(ISABELLE_HOME)/bin/isabelle),$(ISABELLE_HOME)/bin/isabelle,isabelle)

ifeq ($(shell command -v "$(ISABELLE_BIN)" > /dev/null 2>&1 && echo yes),)
$(error Isabelle binary not found or not executable at $(ISABELLE_BIN). \
Set ISABELLE_HOME correctly, e.g. make ISABELLE_HOME=/path/to/Isabelle, or ensure
'isabelle' is in your PATH)
endif

.PHONY: all
all:
	@echo "notmuch"
	$(ISABELLE_BIN)

