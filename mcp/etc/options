section "MCP server"

public option mcp_shutdown_drain : real = 10.0
  -- "seconds to wait for in-flight requests when stdin closes (0 = do not wait)"

public option mcp_max_in_flight : int = 8
  -- "maximum ordinary requests admitted by one MCP connection"

public option mcp_max_input_message_bytes : int = 1048576
  -- "maximum raw UTF-8 bytes in one inbound JSON-RPC message"

public option mcp_request_timeout : real = 60.0
  -- "seconds an admitted ordinary MCP request may run before timing out"

public option mcp_bridge_max_request_bytes : int = 262144
  -- "maximum serialized PIDE bridge request envelope size in bytes"

public option mcp_bridge_max_reply_bytes : int = 1048576
  -- "maximum serialized PIDE bridge reply envelope size in bytes"

public option mcp_untrusted_output_bytes : int = 0
  -- "maximum accounted output bytes captured from one tool call (0 = disabled)"
