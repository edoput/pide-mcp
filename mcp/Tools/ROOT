session "MCP-Tools" = Pure +
  description "MCP tool registry and protocol commands for isabelle mcp_server"
  theories
    MCP_Tools

session "MCP-Assumption" in "Assumption" = Pure +
  description "Structured links from Isabelle theory tests to plans"
  theories
    MCP_Assumption

session "MCP-Tools-Tests" in "Tests" = "MCP-Tools" +
  description "Unit tests for the MCP tool registry and protocol payloads"
  sessions
    "MCP-Assumption"
  theories
    MCP_Tools_Tests

session "MCP-HOL" in "HOL" = HOL +
  description "HOL-safe MCP tool registration"
  sessions
    "MCP-Tools"
  theories
    MCP

session "MCP-HOL-Tests" in "HOL/Tests" = "MCP-HOL" +
  description "HOL-safe registration regression tests"
  sessions
    "MCP-Assumption"
    "HOL-Library"
  theories
    MCP_HOL_Tests
    MCP_HOL_Import_Tests
